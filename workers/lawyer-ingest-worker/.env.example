# Example env for Lawyer Ingest Worker
RABBITMQ_URL=amqp://lexcam:pass@rabbitmq:5672/
LAWYER_SERVICE_URL=http://lawyer-service:8002
INTERNAL_SERVICE_KEY=your-internal-key
EXCHANGE=lexcam.events
DLX_EXCHANGE=lexcam.dlx
QUEUE=lawyer-ingest-worker.lawyers.scraped
ROUTING_KEY=lawyers.scraped
BATCH_SIZE=20
